# AI: SITE_ADDRESS - либо домен (Caddy сам получает сертификат Let's Encrypt), либо ":80", когда
# внешний nginx терминирует TLS и проксирует в этот контейнер. Mini Apps в любом случае требуют
# HTTPS снаружи.
{$SITE_ADDRESS} {
	encode zstd gzip

	# AI: Заголовки безопасности для SPA. frame-ancestors позволяет Telegram встраивать Mini App.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; frame-ancestors https://web.telegram.org https://*.telegram.org 'self'"
		-Server
	}

	# AI: API на том же origin -> в production никакого CORS. Для SSE нужен flush_interval -1.
	handle /api/* {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}
	handle /health {
		reverse_proxy api:8080
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
