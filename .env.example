# Скопируйте в .env и заполните. Файл .env не попадает ни в git, ни в образы — только на сервер.
# Значения по умолчанию подходят для локального запуска без Docker (PGlite + шина в памяти).

# ---------- Только для docker compose ----------
DOMAIN=your-domain.example              # публичное имя сайта; без nginx Caddy сам получит сертификат
POSTGRES_PASSWORD=                      # пароль БД внутри compose-сети
# Если на сервере уже есть nginx (или другой прокси), раскомментируйте три строки: наш web слушает
# только localhost:8081 по HTTP, а TLS и порт 443 остаются за nginx (конфиг: deploy/nginx.conf)
# WEB_HTTP_BIND=127.0.0.1:8081
# WEB_HTTPS_BIND=127.0.0.1:8444
# SITE_ADDRESS=:80

# ---------- LLM ----------
ANTHROPIC_API_KEY=                      # только на сервере; в браузер и в логи не попадает
LLM_BASE_URL=https://api.anthropic.com  # или адрес шлюза, совместимого с Messages API
LLM_MODEL=claude-opus-5
LLM_EFFORT=low                          # low | medium | high — задержка ответа против глубины
LLM_TIMEOUT_MS=25000                    # таймаут запроса, 1 повтор; дальше — детерминированный ответ по базе

# ---------- Вход пользователей ----------
JWT_SECRET=                             # 32+ случайных символов: openssl rand -base64 32
JWT_TTL=12h
WEB_GUEST_LOGIN=true                    # вход гостем на сайте: анонимно, публичные темы, без заявок
WEB_DEMO_LOGIN=true                     # вход «студентом» по имени без проверки: демо и тесты; на проде включать осознанно
WEB_APP_URL=https://your-domain.example # адрес Mini App, который открывает бот

TELEGRAM_BOT_TOKEN=                     # проверка подписи initData + уведомления
TELEGRAM_BOT_USERNAME=                  # для ссылки «Открыть в Telegram» на сайте
TELEGRAM_API_ROOT=                      # если api.telegram.org недоступен с сервера: адрес прокси-worker'а (deploy/telegram-proxy.worker.js)
VK_APP_SECRET=                          # включает /api/auth/vk
VK_APP_ID=
MAX_BOT_TOKEN=                          # включает /api/auth/max
MAX_SECRET_LABEL=WebAppData

# ---------- Корпоративный вход (любое подмножество; каждый добавляет свои маршруты) ----------
# SSO по OpenID Connect (Keycloak / ADFS / любой IdP)
OIDC_ISSUER=                            # https://sso.tpu.ru/realms/tpu
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://your-domain.example/api/auth/sso/callback
OIDC_SCOPES=openid profile email
OIDC_CLAIM_ID=preferred_username        # ADFS: upn
OIDC_CLAIM_NAME=name
OIDC_CLAIM_EMAIL=email
OIDC_CLAIM_GROUPS=groups                # ADFS: role
SSO_LABEL=Войти через учётную запись ТПУ
# LDAP / Active Directory (тот же логин, что для Wi-Fi и Moodle)
LDAP_URL=                               # ldaps://dc.tpu.ru:636
LDAP_BIND_TEMPLATE={login}@tpu.ru       # или TPU\{login}
LDAP_BASE_DN=                           # DC=main,DC=tpu,DC=ru
LDAP_SEARCH_FILTER=(sAMAccountName={login})
LDAP_ATTR_NAME=displayName
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_GROUPS=memberOf
LDAP_TLS_REJECT_UNAUTHORIZED=true
# Одноразовый код на корпоративную почту (если доступа к домену нет)
EMAIL_AUTH_DOMAINS=tpu.ru
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=helpdesk-bot@tpu.ru

# ---------- Роли ----------
OPERATOR_GROUPS=helpdesk-operators      # группы (DN или CN), участники которых получают консоль оператора
ADMIN_USERS=                            # platform:id через запятую, например telegram:123456 — доступ к /api/admin/*
OPERATOR_OPEN_ACCESS=false              # демо: консоль оператора (не админка) всем; на проде отклоняется

# ---------- Хранилище и события ----------
DATABASE_URL=                           # пусто — встроенный PGlite в PGLITE_DIR; прод: postgres://user:pass@host:5432/db
PGLITE_DIR=./data/pglite
EVENT_BUS=memory                        # memory | kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=helpdesk-api

# ---------- HTTP ----------
PORT=8080
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173      # на проде фронт и API за одним доменом — CORS не нужен
RATE_LIMIT_PER_MINUTE=90
BODY_LIMIT_BYTES=16384
LOG_LEVEL=info

# ---------- Знания ----------
CATALOG_SEED_DIR=./data/catalog         # каждый *.json — тенант (сфера); импортируется, если его нет в БД
CATALOG_SEED_FORCE=false                # true — переимпортировать при каждом старте (dev)
DEFAULT_TENANT=tpu
MAX_CLARIFICATIONS=2                    # максимум уточняющих вопросов на обращение
CONFIDENCE_THRESHOLD=0.6                # ниже — предложить выбор категории кнопками
HISTORY_TURNS=12                        # сколько реплик диалога передаётся модели

# RAG по документации (data/raw — результат scripts/crawl-*.mjs)
RAG_ENABLED=true
RAG_EMBEDDINGS=local                    # local — ONNX-модель внутри процесса, без внешних запросов | off — только BM25
RAG_EMBEDDING_MODEL=Xenova/multilingual-e5-small
RAG_RAW_DIR=./data/raw
RAG_MODEL_DIR=./data/models             # кэш модели; в образ API она уже включена
RAG_INGEST_ON_BOOT=true                 # переиндексировать при старте (неизменённые фрагменты не пересчитываются)

# ---------- Внешний helpdesk (заявка создаётся только с согласия пользователя) ----------
HELPDESK_KIND=none                      # none | naumen (help.tpu.ru работает на Naumen Service Desk)
NAUMEN_URL=https://help.tpu.ru
NAUMEN_ACCESS_KEY=                      # ключ REST API от администратора Naumen
NAUMEN_DEFAULT_SERVICE=                 # slmService$… — услуга по умолчанию
NAUMEN_SERVICE_BY_CATEGORY=             # JSON: {"network":"slmService$4550406"}
