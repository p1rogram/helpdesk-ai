# ---------- LLM ----------
ANTHROPIC_API_KEY=sk-ant-...            # ONLY on the server. Never shipped to the client bundle.
LLM_BASE_URL=https://api.anthropic.com   # or an aggregator origin exposing the Anthropic Messages API
LLM_MODEL=claude-opus-5
LLM_EFFORT=low                          # low | medium | high — chat latency vs depth
LLM_TIMEOUT_MS=25000                    # per-request timeout, 1 retry; then deterministic fallback answers

# ---------- Auth ----------
TELEGRAM_BOT_TOKEN=123456:ABC...        # used to verify Mini App initData + send notifications
JWT_SECRET=change-me-to-32-plus-random-chars
AUTH_DEV_BYPASS=true                    # allows POST /api/auth/dev (guest login) — set false in prod
WEB_APP_URL=https://your-domain.example # Mini App URL the bot opens

# ---------- Storage ----------
# Leave DATABASE_URL empty to use embedded PGlite (./data/pglite) — zero-install dev/demo mode
DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/helpdesk

# ---------- Events ----------
EVENT_BUS=memory                        # memory | kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=helpdesk-api

# ---------- HTTP ----------
PORT=8080
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,https://your-domain.example
RATE_LIMIT_PER_MINUTE=90
LOG_LEVEL=info

# ---------- Domain ----------
CATALOG_FILE=./data/catalog/it-support.json
MAX_CLARIFICATIONS=2
CONFIDENCE_THRESHOLD=0.6

CATALOG_SEED_FORCE=false
