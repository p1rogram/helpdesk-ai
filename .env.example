# ---------- LLM ----------
ANTHROPIC_API_KEY=sk-ant-...            # ONLY on the server. Never shipped to the client bundle.
LLM_BASE_URL=https://api.anthropic.com   # or an aggregator origin exposing the Anthropic Messages API
LLM_MODEL=claude-opus-5
LLM_EFFORT=low                          # low | medium | high — chat latency vs depth
LLM_TIMEOUT_MS=25000                    # per-request timeout, 1 retry; then deterministic fallback answers

# ---------- Auth ----------
TELEGRAM_BOT_TOKEN=123456:ABC...        # used to verify Mini App initData + send notifications
TELEGRAM_BOT_USERNAME=your_bot            # for the "Open in Telegram" link on the website
JWT_SECRET=change-me-to-32-plus-random-chars
AUTH_DEV_BYPASS=true                    # allows POST /api/auth/dev (guest login) — set false in prod
WEB_APP_URL=https://your-domain.example # Mini App URL the bot opens

# ---------- Storage ----------
# Leave DATABASE_URL empty to use embedded PGlite (./data/pglite) — zero-install dev/demo mode
DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/helpdesk

# ---------- Events ----------
EVENT_BUS=memory                        # memory | kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=helpdesk-api

# ---------- HTTP ----------
PORT=8080
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,https://your-domain.example
RATE_LIMIT_PER_MINUTE=90
LOG_LEVEL=info

# ---------- Domain ----------
CATALOG_FILE=./data/catalog/it-support.json
MAX_CLARIFICATIONS=2
CONFIDENCE_THRESHOLD=0.6

CATALOG_SEED_FORCE=false

# ---------- External helpdesk (request creation on user consent) ----------
HELPDESK_KIND=none                      # none | naumen (help.tpu.ru runs Naumen Service Desk)
NAUMEN_URL=https://help.tpu.ru
NAUMEN_ACCESS_KEY=                      # REST access key from the Naumen administrator
NAUMEN_DEFAULT_SERVICE=slmService$0000000
NAUMEN_SERVICE_BY_CATEGORY={"network":"slmService$4550406"}

# ---------- Other messengers (same Mini App, one verifier each) ----------
VK_APP_SECRET=                          # dev.vk.com -> app settings -> secret key (enables /api/auth/vk)
VK_APP_ID=
MAX_BOT_TOKEN=                          # MAX developer console (enables /api/auth/max)
MAX_SECRET_LABEL=WebAppData

# ---------- Corporate identity socket (enable any subset; each adds its own login routes) ----------
# SSO via OpenID Connect (Keycloak / ADFS / any OIDC IdP)
OIDC_ISSUER=                            # e.g. https://sso.tpu.ru/realms/tpu
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://your-domain.example/api/auth/sso/callback
OIDC_SCOPES=openid profile email
OIDC_CLAIM_ID=preferred_username        # ADFS: upn
OIDC_CLAIM_GROUPS=groups                # ADFS: role
SSO_LABEL=Войти через учётную запись ТПУ
# LDAP / Active Directory bind (same login as Wi-Fi / Moodle)
LDAP_URL=                               # ldaps://dc.tpu.ru:636
LDAP_BIND_TEMPLATE={login}@tpu.ru       # or TPU\{login}
LDAP_BASE_DN=                           # DC=main,DC=tpu,DC=ru
LDAP_SEARCH_FILTER=(sAMAccountName={login})
# One-time code to corporate mail (when no domain access is granted)
EMAIL_AUTH_DOMAINS=tpu.ru
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=helpdesk-bot@tpu.ru
# Groups (DN or CN) whose members get the operator console
OPERATOR_GROUPS=helpdesk-operators

# Demo/testing: give the operator console to every logged-in user (must stay false in production)
OPERATOR_OPEN_ACCESS=false
