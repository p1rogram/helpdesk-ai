<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="P03_defs" targetNamespace="http://tpu.ru/pomogi-mne" exporter="pomogi-mne" exporterVersion="1">
  <bpmn:collaboration id="P03_collab">
    <bpmn:participant id="P03_pool" name="Эскалация к специалисту" processRef="P03_proc" />
  </bpmn:collaboration>
  <bpmn:process id="P03_proc" isExecutable="false">
    <bpmn:laneSet id="P03_ls">
      <bpmn:lane id="P03_U" name="Пользователь">
        <bpmn:flowNodeRef>P03_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_lmsg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_elim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_ntf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P03_B" name="Бэк (движок)">
        <bpmn:flowNodeRef>P03_gtr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_try</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_etry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_glim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_fld</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_gcf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_eno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_grt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_gm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P03_X" name="help.tpu.ru (Naumen) · консоль оператора">
        <bpmn:flowNodeRef>P03_nau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_op</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P03_s" name="Просит специалиста / «не помогло»">
      <bpmn:outgoing>P03_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="P03_gtr" name="Решение уже предлагалось?">
      <bpmn:incoming>P03_f1</bpmn:incoming>
      <bpmn:outgoing>P03_f2</bpmn:outgoing>
      <bpmn:outgoing>P03_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P03_try" name="Сначала предложить решение">
      <bpmn:incoming>P03_f2</bpmn:incoming>
      <bpmn:outgoing>P03_f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P03_etry" name="Ждём результат">
      <bpmn:incoming>P03_f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P03_glim" name="Дневной лимит исчерпан?">
      <bpmn:incoming>P03_f4</bpmn:incoming>
      <bpmn:outgoing>P03_f5</bpmn:outgoing>
      <bpmn:outgoing>P03_f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P03_lmsg" name="Сообщить о лимите, дать контакты">
      <bpmn:incoming>P03_f5</bpmn:incoming>
      <bpmn:outgoing>P03_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P03_elim" name="Без заявки">
      <bpmn:incoming>P03_f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="P03_fld" name="Собрать недостающие поля (корпус, комната…)">
      <bpmn:incoming>P03_f7</bpmn:incoming>
      <bpmn:outgoing>P03_f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="P03_card" name="Карточка «что отправим» + фото (по желанию) — подтвердить">
      <bpmn:incoming>P03_f8</bpmn:incoming>
      <bpmn:outgoing>P03_f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P03_gcf" name="Подтвердил?">
      <bpmn:incoming>P03_f9</bpmn:incoming>
      <bpmn:outgoing>P03_f10</bpmn:outgoing>
      <bpmn:outgoing>P03_f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P03_eno" name="Отменено">
      <bpmn:incoming>P03_f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P03_grt" name="Бытовая и несложная?">
      <bpmn:incoming>P03_f11</bpmn:incoming>
      <bpmn:outgoing>P03_f12</bpmn:outgoing>
      <bpmn:outgoing>P03_f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P03_nau" name="Заявка в help.tpu.ru (Naumen) + вложения">
      <bpmn:incoming>P03_f12</bpmn:incoming>
      <bpmn:outgoing>P03_f14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P03_op" name="В очередь консоли оператора (с фото)">
      <bpmn:incoming>P03_f13</bpmn:incoming>
      <bpmn:outgoing>P03_f15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P03_gm" name="">
      <bpmn:incoming>P03_f14</bpmn:incoming>
      <bpmn:incoming>P03_f15</bpmn:incoming>
      <bpmn:outgoing>P03_f16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P03_ntf" name="Номер заявки в чат, пуш при смене статуса">
      <bpmn:incoming>P03_f16</bpmn:incoming>
      <bpmn:outgoing>P03_f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P03_e" name="Заявка создана">
      <bpmn:incoming>P03_f17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P03_f1" sourceRef="P03_s" targetRef="P03_gtr" />
    <bpmn:sequenceFlow id="P03_f2" name="нет" sourceRef="P03_gtr" targetRef="P03_try" />
    <bpmn:sequenceFlow id="P03_f3" sourceRef="P03_try" targetRef="P03_etry" />
    <bpmn:sequenceFlow id="P03_f4" name="да" sourceRef="P03_gtr" targetRef="P03_glim" />
    <bpmn:sequenceFlow id="P03_f5" name="да" sourceRef="P03_glim" targetRef="P03_lmsg" />
    <bpmn:sequenceFlow id="P03_f6" sourceRef="P03_lmsg" targetRef="P03_elim" />
    <bpmn:sequenceFlow id="P03_f7" name="нет" sourceRef="P03_glim" targetRef="P03_fld" />
    <bpmn:sequenceFlow id="P03_f8" sourceRef="P03_fld" targetRef="P03_card" />
    <bpmn:sequenceFlow id="P03_f9" sourceRef="P03_card" targetRef="P03_gcf" />
    <bpmn:sequenceFlow id="P03_f10" name="нет" sourceRef="P03_gcf" targetRef="P03_eno" />
    <bpmn:sequenceFlow id="P03_f11" name="да" sourceRef="P03_gcf" targetRef="P03_grt" />
    <bpmn:sequenceFlow id="P03_f12" name="да" sourceRef="P03_grt" targetRef="P03_nau" />
    <bpmn:sequenceFlow id="P03_f13" name="нет" sourceRef="P03_grt" targetRef="P03_op" />
    <bpmn:sequenceFlow id="P03_f14" sourceRef="P03_nau" targetRef="P03_gm" />
    <bpmn:sequenceFlow id="P03_f15" sourceRef="P03_op" targetRef="P03_gm" />
    <bpmn:sequenceFlow id="P03_f16" sourceRef="P03_gm" targetRef="P03_ntf" />
    <bpmn:sequenceFlow id="P03_f17" sourceRef="P03_ntf" targetRef="P03_e" />
  </bpmn:process>
