      <bpmndi:BPMNEdge id="P01_f8_di" bpmnElement="P01_f8"><di:waypoint x="1040.0" y="677.5" /><di:waypoint x="1085.0" y="677.5" /><di:waypoint x="1085.0" y="292.5" /><di:waypoint x="1130.0" y="292.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P01_f9_di" bpmnElement="P01_f9"><di:waypoint x="1180.0" y="292.5" /><di:waypoint x="1270.0" y="292.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P01_f10_di" bpmnElement="P01_f10"><di:waypoint x="1410.0" y="292.5" /><di:waypoint x="1500.0" y="292.5" /></bpmndi:BPMNEdge>
