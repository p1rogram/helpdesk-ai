      <bpmndi:BPMNEdge id="P01_f12_di" bpmnElement="P01_f12"><di:waypoint x="1525" y="317.5" /><di:waypoint x="1525" y="407.5" /><di:waypoint x="1640.0" y="407.5" /><bpmndi:BPMNLabel><dc:Bounds x="1531" y="354.5" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P01_f13_di" bpmnElement="P01_f13"><di:waypoint x="1780.0" y="832.5" /><di:waypoint x="1825.0" y="832.5" /><di:waypoint x="1825.0" y="292.5" /><di:waypoint x="1870.0" y="292.5" /></bpmndi:BPMNEdge>
