<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="P01_defs" targetNamespace="http://tpu.ru/pomogi-mne" exporter="pomogi-mne" exporterVersion="1">
  <bpmn:collaboration id="P01_collab">
    <bpmn:participant id="P01_pool" name="Обработка сообщения: бэк управляет, ML только считает" processRef="P01_proc" />
  </bpmn:collaboration>
  <bpmn:process id="P01_proc" isExecutable="false">
    <bpmn:laneSet id="P01_ls">
      <bpmn:lane id="P01_U" name="Пользователь">
        <bpmn:flowNodeRef>P01_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P01_B" name="Бэк (API, движок)">
        <bpmn:flowNodeRef>P01_lim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_gml</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_ps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_pj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_gval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_fb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_gf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_ask</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P01_M" name="ML-сервер · Spark (vLLM)">
        <bpmn:flowNodeRef>P01_an</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_emb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_ans</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P01_D" name="База · Postgres + pgvector">
        <bpmn:flowNodeRef>P01_srch</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P01_s" name="Сообщение в чате">
      <bpmn:outgoing>P01_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P01_lim" name="Лимиты, бюджет гостя, блокировка обращения">
      <bpmn:incoming>P01_f1</bpmn:incoming>
      <bpmn:outgoing>P01_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P01_gml" name="Модель доступна?">
      <bpmn:incoming>P01_f2</bpmn:incoming>
      <bpmn:outgoing>P01_f3</bpmn:outgoing>
      <bpmn:outgoing>P01_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="P01_ps" name="">
      <bpmn:incoming>P01_f3</bpmn:incoming>
      <bpmn:outgoing>P01_f5</bpmn:outgoing>
      <bpmn:outgoing>P01_f6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="P01_an" name="Анализ сообщения → JSON (категория, поля, флаги)">
      <bpmn:incoming>P01_f5</bpmn:incoming>
      <bpmn:outgoing>P01_f7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P01_emb" name="Эмбеддинг вопроса">
      <bpmn:incoming>P01_f6</bpmn:incoming>
      <bpmn:outgoing>P01_f8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="P01_pj" name="">
      <bpmn:incoming>P01_f7</bpmn:incoming>
      <bpmn:incoming>P01_f8</bpmn:incoming>
      <bpmn:outgoing>P01_f9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="P01_val" name="Проверка JSON: схема, белые списки полей">
      <bpmn:incoming>P01_f9</bpmn:incoming>
      <bpmn:outgoing>P01_f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P01_gval" name="JSON валиден?">
      <bpmn:incoming>P01_f10</bpmn:incoming>
      <bpmn:outgoing>P01_f11</bpmn:outgoing>
      <bpmn:outgoing>P01_f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P01_fb" name="Упрощённый режим: ключевые слова + шаги статьи">
      <bpmn:incoming>P01_f4</bpmn:incoming>
      <bpmn:incoming>P01_f12</bpmn:incoming>
      <bpmn:outgoing>P01_f18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="P01_srch" name="Поиск: кэш, каталог, pgvector + BM25">
      <bpmn:incoming>P01_f11</bpmn:incoming>
      <bpmn:outgoing>P01_f13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P01_gf" name="Все нужные поля есть?">
      <bpmn:incoming>P01_f13</bpmn:incoming>
      <bpmn:outgoing>P01_f14</bpmn:outgoing>
      <bpmn:outgoing>P01_f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P01_ask" name="Спросить недостающее одним сообщением">
      <bpmn:incoming>P01_f15</bpmn:incoming>
      <bpmn:outgoing>P01_f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="P01_ans" name="Ответ по статье / фрагментам (поток)">
      <bpmn:incoming>P01_f14</bpmn:incoming>
      <bpmn:outgoing>P01_f16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="P01_show" name="Показать ответ и кнопки">
      <bpmn:incoming>P01_f16</bpmn:incoming>
      <bpmn:incoming>P01_f17</bpmn:incoming>
      <bpmn:incoming>P01_f18</bpmn:incoming>
      <bpmn:outgoing>P01_f19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P01_e" name="Ждём реакцию пользователя">
      <bpmn:incoming>P01_f19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P01_f1" sourceRef="P01_s" targetRef="P01_lim" />
    <bpmn:sequenceFlow id="P01_f2" sourceRef="P01_lim" targetRef="P01_gml" />
    <bpmn:sequenceFlow id="P01_f3" name="да" sourceRef="P01_gml" targetRef="P01_ps" />
    <bpmn:sequenceFlow id="P01_f4" name="нет" sourceRef="P01_gml" targetRef="P01_fb" />
    <bpmn:sequenceFlow id="P01_f5" sourceRef="P01_ps" targetRef="P01_an" />
    <bpmn:sequenceFlow id="P01_f6" sourceRef="P01_ps" targetRef="P01_emb" />
    <bpmn:sequenceFlow id="P01_f7" sourceRef="P01_an" targetRef="P01_pj" />
    <bpmn:sequenceFlow id="P01_f8" sourceRef="P01_emb" targetRef="P01_pj" />
    <bpmn:sequenceFlow id="P01_f9" sourceRef="P01_pj" targetRef="P01_val" />
    <bpmn:sequenceFlow id="P01_f10" sourceRef="P01_val" targetRef="P01_gval" />
    <bpmn:sequenceFlow id="P01_f11" name="да" sourceRef="P01_gval" targetRef="P01_srch" />
    <bpmn:sequenceFlow id="P01_f12" name="нет" sourceRef="P01_gval" targetRef="P01_fb" />
    <bpmn:sequenceFlow id="P01_f13" sourceRef="P01_srch" targetRef="P01_gf" />
    <bpmn:sequenceFlow id="P01_f14" name="да" sourceRef="P01_gf" targetRef="P01_ans" />
    <bpmn:sequenceFlow id="P01_f15" name="нет" sourceRef="P01_gf" targetRef="P01_ask" />
    <bpmn:sequenceFlow id="P01_f16" sourceRef="P01_ans" targetRef="P01_show" />
    <bpmn:sequenceFlow id="P01_f17" sourceRef="P01_ask" targetRef="P01_show" />
    <bpmn:sequenceFlow id="P01_f18" sourceRef="P01_fb" targetRef="P01_show" />
    <bpmn:sequenceFlow id="P01_f19" sourceRef="P01_show" targetRef="P01_e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P01_diagram">
    <bpmndi:BPMNPlane id="P01_plane" bpmnElement="P01_collab">
      <bpmndi:BPMNShape id="P01_pool_di" bpmnElement="P01_pool" isHorizontal="true"><dc:Bounds x="100" y="60" width="2480" height="850" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P01_U_di" bpmnElement="P01_U" isHorizontal="true"><dc:Bounds x="130" y="60" width="2450" height="155" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P01_B_di" bpmnElement="P01_B" isHorizontal="true"><dc:Bounds x="130" y="215" width="2450" height="270" /></bpmndi:BPMNShape>
