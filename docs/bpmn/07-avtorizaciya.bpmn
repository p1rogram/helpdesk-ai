<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="P07_defs" targetNamespace="http://tpu.ru/pomogi-mne" exporter="pomogi-mne" exporterVersion="1">
  <bpmn:collaboration id="P07_collab">
    <bpmn:participant id="P07_pool" name="Авторизация: только вход через ТПУ, агент действует от имени пользователя" processRef="P07_proc" />
  </bpmn:collaboration>
  <bpmn:process id="P07_proc" isExecutable="false">
    <bpmn:laneSet id="P07_ls">
      <bpmn:lane id="P07_U" name="Пользователь">
        <bpmn:flowNodeRef>P07_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_lg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P07_A" name="Приложение (мобилка / сайт / Mini App)">
        <bpmn:flowNodeRef>P07_gs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_rd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_rq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P07_B" name="Бэк">
        <bpmn:flowNodeRef>P07_ex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_pr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_ck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_gx</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P07_O" name="oauth.tpu.ru (OpenID Connect)">
        <bpmn:flowNodeRef>P07_cd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_rf</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P07_P" name="MCP-сервер ТПУ">
        <bpmn:flowNodeRef>P07_tc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P07_S" name="Сервис ТПУ">
        <bpmn:flowNodeRef>P07_sv</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P07_s" name="Открыл приложение">
      <bpmn:outgoing>P07_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="P07_gs" name="Есть действующая сессия?">
      <bpmn:incoming>P07_f1</bpmn:incoming>
      <bpmn:outgoing>P07_f2</bpmn:outgoing>
      <bpmn:outgoing>P07_f3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P07_rd" name="Перенаправить на oauth.tpu.ru (код + PKCE)">
      <bpmn:incoming>P07_f2</bpmn:incoming>
      <bpmn:outgoing>P07_f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="P07_lg" name="Вход: учётная запись ТПУ / Госуслуги">
      <bpmn:incoming>P07_f4</bpmn:incoming>
      <bpmn:outgoing>P07_f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P07_cd" name="Выдать код авторизации">
      <bpmn:incoming>P07_f5</bpmn:incoming>
      <bpmn:outgoing>P07_f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P07_ex" name="Обменять код на токены, получить userinfo">
      <bpmn:incoming>P07_f6</bpmn:incoming>
      <bpmn:outgoing>P07_f7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="P07_pr" name="Профиль: роль, группа (api.tpu.ru); выдать сессию">
      <bpmn:incoming>P07_f7</bpmn:incoming>
      <bpmn:outgoing>P07_f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P07_rq" name="Запрос с сессией">
      <bpmn:incoming>P07_f3</bpmn:incoming>
      <bpmn:incoming>P07_f8</bpmn:incoming>
      <bpmn:outgoing>P07_f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P07_ck" name="Проверить сессию и лимиты пользователя; без сессии — 401">
      <bpmn:incoming>P07_f9</bpmn:incoming>
      <bpmn:outgoing>P07_f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P07_gx" name="Токен ТПУ истёк?">
      <bpmn:incoming>P07_f10</bpmn:incoming>
      <bpmn:outgoing>P07_f11</bpmn:outgoing>
      <bpmn:outgoing>P07_f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P07_rf" name="Обновить токен">
      <bpmn:incoming>P07_f11</bpmn:incoming>
      <bpmn:outgoing>P07_f13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P07_tc" name="tools/call: политика приложения и права пользователя">
      <bpmn:incoming>P07_f12</bpmn:incoming>
      <bpmn:incoming>P07_f13</bpmn:incoming>
      <bpmn:outgoing>P07_f14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P07_sv" name="Запрос от имени пользователя, журнал">
      <bpmn:incoming>P07_f14</bpmn:incoming>
      <bpmn:outgoing>P07_f15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P07_e" name="Данные в приложении">
      <bpmn:incoming>P07_f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P07_f1" sourceRef="P07_s" targetRef="P07_gs" />
    <bpmn:sequenceFlow id="P07_f2" name="нет" sourceRef="P07_gs" targetRef="P07_rd" />
    <bpmn:sequenceFlow id="P07_f3" name="да" sourceRef="P07_gs" targetRef="P07_rq" />
    <bpmn:sequenceFlow id="P07_f4" sourceRef="P07_rd" targetRef="P07_lg" />
    <bpmn:sequenceFlow id="P07_f5" sourceRef="P07_lg" targetRef="P07_cd" />
    <bpmn:sequenceFlow id="P07_f6" sourceRef="P07_cd" targetRef="P07_ex" />
    <bpmn:sequenceFlow id="P07_f7" sourceRef="P07_ex" targetRef="P07_pr" />
    <bpmn:sequenceFlow id="P07_f8" sourceRef="P07_pr" targetRef="P07_rq" />
    <bpmn:sequenceFlow id="P07_f9" sourceRef="P07_rq" targetRef="P07_ck" />
    <bpmn:sequenceFlow id="P07_f10" sourceRef="P07_ck" targetRef="P07_gx" />
    <bpmn:sequenceFlow id="P07_f11" name="да" sourceRef="P07_gx" targetRef="P07_rf" />
    <bpmn:sequenceFlow id="P07_f12" name="нет" sourceRef="P07_gx" targetRef="P07_tc" />
    <bpmn:sequenceFlow id="P07_f13" sourceRef="P07_rf" targetRef="P07_tc" />
    <bpmn:sequenceFlow id="P07_f14" sourceRef="P07_tc" targetRef="P07_sv" />
    <bpmn:sequenceFlow id="P07_f15" sourceRef="P07_sv" targetRef="P07_e" />
  </bpmn:process>
