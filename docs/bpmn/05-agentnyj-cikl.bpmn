      <bpmndi:BPMNShape id="P05_gt_di" bpmnElement="P05_gt" isMarkerVisible="true"><dc:Bounds x="945.0" y="422.5" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="910.0" y="478.5" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05_val_di" bpmnElement="P05_val"><dc:Bounds x="1085.0" y="409.5" width="140" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05_gw_di" bpmnElement="P05_gw" isMarkerVisible="true"><dc:Bounds x="1315.0" y="422.5" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1280.0" y="478.5" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05_cf_di" bpmnElement="P05_cf"><dc:Bounds x="1455.0" y="99.5" width="140" height="76" /></bpmndi:BPMNShape>
