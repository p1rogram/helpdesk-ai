      <bpmndi:BPMNEdge id="P05_f7_di" bpmnElement="P05_f7"><di:waypoint x="1225.0" y="447.5" /><di:waypoint x="1315.0" y="447.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P05_f8_di" bpmnElement="P05_f8"><di:waypoint x="1340" y="422.5" /><di:waypoint x="1340" y="137.5" /><di:waypoint x="1455.0" y="137.5" /><bpmndi:BPMNLabel><dc:Bounds x="1346" y="272.0" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
