      <bpmndi:BPMNShape id="P05_e_di" bpmnElement="P05_e"><dc:Bounds x="2617.0" y="119.5" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2575.0" y="161.5" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P05_f1_di" bpmnElement="P05_f1"><di:waypoint x="248.0" y="137.5" /><di:waypoint x="296.5" y="137.5" /><di:waypoint x="296.5" y="292.5" /><di:waypoint x="345.0" y="292.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P05_f2_di" bpmnElement="P05_f2"><di:waypoint x="485.0" y="292.5" /><di:waypoint x="507.5" y="292.5" /><di:waypoint x="507.5" y="447.5" /><di:waypoint x="530.0" y="447.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P05_f3_di" bpmnElement="P05_f3"><di:waypoint x="670.0" y="447.5" /><di:waypoint x="692.5" y="447.5" /><di:waypoint x="692.5" y="717.5" /><di:waypoint x="715.0" y="717.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P05_f4_di" bpmnElement="P05_f4"><di:waypoint x="855.0" y="717.5" /><di:waypoint x="900.0" y="717.5" /><di:waypoint x="900.0" y="447.5" /><di:waypoint x="945.0" y="447.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P05_f5_di" bpmnElement="P05_f5"><di:waypoint x="995.0" y="447.5" /><di:waypoint x="1085.0" y="447.5" /><bpmndi:BPMNLabel><dc:Bounds x="1010.0" y="427.5" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
