      <bpmndi:BPMNEdge id="P05_f10_di" bpmnElement="P05_f10"><di:waypoint x="1595.0" y="137.5" /><di:waypoint x="1640.0" y="137.5" /><di:waypoint x="1640.0" y="447.5" /><di:waypoint x="1685.0" y="447.5" /></bpmndi:BPMNEdge>
