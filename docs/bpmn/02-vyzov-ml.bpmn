<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="P02_defs" targetNamespace="http://tpu.ru/pomogi-mne" exporter="pomogi-mne" exporterVersion="1">
  <bpmn:collaboration id="P02_collab">
    <bpmn:participant id="P02_pool" name="Вызов ML: очередь, таймаут, повтор, выключатель" processRef="P02_proc" />
  </bpmn:collaboration>
  <bpmn:process id="P02_proc" isExecutable="false">
    <bpmn:laneSet id="P02_ls">
      <bpmn:lane id="P02_B" name="Бэк (API)">
        <bpmn:flowNodeRef>P02_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_gcb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_fb0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_gok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_rst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_eok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_grt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_inc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_gthr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_efb</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P02_M" name="ML-сервер · Spark (vLLM)">
        <bpmn:flowNodeRef>P02_call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_wait</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P02_s" name="Нужен вызов модели">
      <bpmn:outgoing>P02_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="P02_gcb" name="Выключатель открыт?">
      <bpmn:incoming>P02_f1</bpmn:incoming>
      <bpmn:outgoing>P02_f2</bpmn:outgoing>
      <bpmn:outgoing>P02_f3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P02_fb0" name="Упрощённый режим">
      <bpmn:incoming>P02_f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="P02_q" name="Очередь: не больше 8 вызовов одновременно">
      <bpmn:incoming>P02_f2</bpmn:incoming>
      <bpmn:outgoing>P02_f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="P02_call" name="Запрос к vLLM (таймаут 20 с)">
      <bpmn:incoming>P02_f4</bpmn:incoming>
      <bpmn:incoming>P02_f10</bpmn:incoming>
      <bpmn:outgoing>P02_f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P02_gok" name="Ответ получен и валиден?">
      <bpmn:incoming>P02_f5</bpmn:incoming>
      <bpmn:outgoing>P02_f6</bpmn:outgoing>
      <bpmn:outgoing>P02_f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P02_rst" name="Сбросить счётчик ошибок">
      <bpmn:incoming>P02_f6</bpmn:incoming>
      <bpmn:outgoing>P02_f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P02_eok" name="Результат модели">
      <bpmn:incoming>P02_f7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P02_grt" name="Повтор уже был?">
      <bpmn:incoming>P02_f8</bpmn:incoming>
      <bpmn:outgoing>P02_f9</bpmn:outgoing>
      <bpmn:outgoing>P02_f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P02_wait" name="Пауза 300 мс">
      <bpmn:incoming>P02_f9</bpmn:incoming>
      <bpmn:outgoing>P02_f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P02_inc" name="Счётчик ошибок +1">
      <bpmn:incoming>P02_f11</bpmn:incoming>
      <bpmn:outgoing>P02_f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P02_gthr" name="Ошибок подряд ≥ 5?">
      <bpmn:incoming>P02_f12</bpmn:incoming>
      <bpmn:outgoing>P02_f13</bpmn:outgoing>
      <bpmn:outgoing>P02_f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P02_open" name="Открыть выключатель на 60 с, сигнал в консоль">
      <bpmn:incoming>P02_f13</bpmn:incoming>
      <bpmn:outgoing>P02_f15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P02_efb" name="Упрощённый режим">
      <bpmn:incoming>P02_f14</bpmn:incoming>
      <bpmn:incoming>P02_f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P02_f1" sourceRef="P02_s" targetRef="P02_gcb" />
    <bpmn:sequenceFlow id="P02_f2" name="нет" sourceRef="P02_gcb" targetRef="P02_q" />
    <bpmn:sequenceFlow id="P02_f3" name="да" sourceRef="P02_gcb" targetRef="P02_fb0" />
    <bpmn:sequenceFlow id="P02_f4" sourceRef="P02_q" targetRef="P02_call" />
    <bpmn:sequenceFlow id="P02_f5" sourceRef="P02_call" targetRef="P02_gok" />
    <bpmn:sequenceFlow id="P02_f6" name="да" sourceRef="P02_gok" targetRef="P02_rst" />
    <bpmn:sequenceFlow id="P02_f7" sourceRef="P02_rst" targetRef="P02_eok" />
    <bpmn:sequenceFlow id="P02_f8" name="нет" sourceRef="P02_gok" targetRef="P02_grt" />
    <bpmn:sequenceFlow id="P02_f9" name="нет" sourceRef="P02_grt" targetRef="P02_wait" />
    <bpmn:sequenceFlow id="P02_f10" sourceRef="P02_wait" targetRef="P02_call" />
    <bpmn:sequenceFlow id="P02_f11" name="да" sourceRef="P02_grt" targetRef="P02_inc" />
    <bpmn:sequenceFlow id="P02_f12" sourceRef="P02_inc" targetRef="P02_gthr" />
    <bpmn:sequenceFlow id="P02_f13" name="да" sourceRef="P02_gthr" targetRef="P02_open" />
    <bpmn:sequenceFlow id="P02_f14" name="нет" sourceRef="P02_gthr" targetRef="P02_efb" />
    <bpmn:sequenceFlow id="P02_f15" sourceRef="P02_open" targetRef="P02_efb" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P02_diagram">
    <bpmndi:BPMNPlane id="P02_plane" bpmnElement="P02_collab">
      <bpmndi:BPMNShape id="P02_pool_di" bpmnElement="P02_pool" isHorizontal="true"><dc:Bounds x="100" y="60" width="2110" height="425" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_B_di" bpmnElement="P02_B" isHorizontal="true"><dc:Bounds x="130" y="60" width="2080" height="270" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_M_di" bpmnElement="P02_M" isHorizontal="true"><dc:Bounds x="130" y="330" width="2080" height="155" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_s_di" bpmnElement="P02_s"><dc:Bounds x="212.0" y="119.5" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="170.0" y="161.5" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_gcb_di" bpmnElement="P02_gcb" isMarkerVisible="true"><dc:Bounds x="390.0" y="112.5" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="355.0" y="168.5" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_fb0_di" bpmnElement="P02_fb0"><dc:Bounds x="582.0" y="234.5" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="540.0" y="276.5" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_q_di" bpmnElement="P02_q"><dc:Bounds x="530.0" y="99.5" width="140" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_call_di" bpmnElement="P02_call"><dc:Bounds x="715.0" y="369.5" width="140" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_gok_di" bpmnElement="P02_gok" isMarkerVisible="true"><dc:Bounds x="945.0" y="112.5" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="910.0" y="168.5" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_rst_di" bpmnElement="P02_rst"><dc:Bounds x="1085.0" y="99.5" width="140" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_eok_di" bpmnElement="P02_eok"><dc:Bounds x="1322.0" y="119.5" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1280.0" y="161.5" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_grt_di" bpmnElement="P02_grt" isMarkerVisible="true"><dc:Bounds x="1130.0" y="227.5" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1095.0" y="283.5" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_wait_di" bpmnElement="P02_wait"><dc:Bounds x="1270.0" y="369.5" width="140" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_inc_di" bpmnElement="P02_inc"><dc:Bounds x="1455.0" y="214.5" width="140" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_gthr_di" bpmnElement="P02_gthr" isMarkerVisible="true"><dc:Bounds x="1685.0" y="227.5" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1650.0" y="283.5" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_open_di" bpmnElement="P02_open"><dc:Bounds x="1825.0" y="99.5" width="140" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_efb_di" bpmnElement="P02_efb"><dc:Bounds x="2062.0" y="234.5" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2020.0" y="276.5" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P02_f1_di" bpmnElement="P02_f1"><di:waypoint x="248.0" y="137.5" /><di:waypoint x="390.0" y="137.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_f2_di" bpmnElement="P02_f2"><di:waypoint x="440.0" y="137.5" /><di:waypoint x="530.0" y="137.5" /><bpmndi:BPMNLabel><dc:Bounds x="455.0" y="117.5" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_f3_di" bpmnElement="P02_f3"><di:waypoint x="415" y="162.5" /><di:waypoint x="415" y="252.5" /><di:waypoint x="582.0" y="252.5" /><bpmndi:BPMNLabel><dc:Bounds x="421" y="199.5" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_f4_di" bpmnElement="P02_f4"><di:waypoint x="670.0" y="137.5" /><di:waypoint x="692.5" y="137.5" /><di:waypoint x="692.5" y="407.5" /><di:waypoint x="715.0" y="407.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_f5_di" bpmnElement="P02_f5"><di:waypoint x="855.0" y="407.5" /><di:waypoint x="900.0" y="407.5" /><di:waypoint x="900.0" y="137.5" /><di:waypoint x="945.0" y="137.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_f6_di" bpmnElement="P02_f6"><di:waypoint x="995.0" y="137.5" /><di:waypoint x="1085.0" y="137.5" /><bpmndi:BPMNLabel><dc:Bounds x="1010.0" y="117.5" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_f7_di" bpmnElement="P02_f7"><di:waypoint x="1225.0" y="137.5" /><di:waypoint x="1322.0" y="137.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_f8_di" bpmnElement="P02_f8"><di:waypoint x="970" y="162.5" /><di:waypoint x="970" y="252.5" /><di:waypoint x="1130.0" y="252.5" /><bpmndi:BPMNLabel><dc:Bounds x="976" y="199.5" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_f9_di" bpmnElement="P02_f9"><di:waypoint x="1155" y="277.5" /><di:waypoint x="1155" y="407.5" /><di:waypoint x="1270.0" y="407.5" /><bpmndi:BPMNLabel><dc:Bounds x="1161" y="334.5" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_f10_di" bpmnElement="P02_f10"><di:waypoint x="1340" y="445.5" /><di:waypoint x="1340" y="473" /><di:waypoint x="785" y="473" /><di:waypoint x="785" y="445.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_f11_di" bpmnElement="P02_f11"><di:waypoint x="1180.0" y="252.5" /><di:waypoint x="1455.0" y="252.5" /><bpmndi:BPMNLabel><dc:Bounds x="1287.5" y="232.5" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_f12_di" bpmnElement="P02_f12"><di:waypoint x="1595.0" y="252.5" /><di:waypoint x="1685.0" y="252.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_f13_di" bpmnElement="P02_f13"><di:waypoint x="1710" y="227.5" /><di:waypoint x="1710" y="137.5" /><di:waypoint x="1825.0" y="137.5" /><bpmndi:BPMNLabel><dc:Bounds x="1716" y="174.5" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_f14_di" bpmnElement="P02_f14"><di:waypoint x="1735.0" y="252.5" /><di:waypoint x="2062.0" y="252.5" /><bpmndi:BPMNLabel><dc:Bounds x="1868.5" y="232.5" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_f15_di" bpmnElement="P02_f15"><di:waypoint x="1965.0" y="137.5" /><di:waypoint x="2013.5" y="137.5" /><di:waypoint x="2013.5" y="252.5" /><di:waypoint x="2062.0" y="252.5" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
