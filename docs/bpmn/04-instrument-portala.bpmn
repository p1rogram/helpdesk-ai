      <bpmndi:BPMNShape id="P04_gal_di" bpmnElement="P04_gal" isMarkerVisible="true"><dc:Bounds x="760.0" y="267.5" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="725.0" y="323.5" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_nt_di" bpmnElement="P04_nt"><dc:Bounds x="900.0" y="369.5" width="140" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_ent_di" bpmnElement="P04_ent"><dc:Bounds x="1137.0" y="389.5" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1095.0" y="431.5" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_gwr_di" bpmnElement="P04_gwr" isMarkerVisible="true"><dc:Bounds x="945.0" y="267.5" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="910.0" y="323.5" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_cf_di" bpmnElement="P04_cf"><dc:Bounds x="1085.0" y="99.5" width="140" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_gok_di" bpmnElement="P04_gok" isMarkerVisible="true"><dc:Bounds x="1315.0" y="267.5" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1280.0" y="323.5" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_ecn_di" bpmnElement="P04_ecn"><dc:Bounds x="1507.0" y="389.5" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1465.0" y="431.5" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_call_di" bpmnElement="P04_call"><dc:Bounds x="1455.0" y="679.5" width="140" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_aud_di" bpmnElement="P04_aud"><dc:Bounds x="1640.0" y="369.5" width="140" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_rt_di" bpmnElement="P04_rt"><dc:Bounds x="1825.0" y="524.5" width="140" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_show_di" bpmnElement="P04_show"><dc:Bounds x="2010.0" y="99.5" width="140" height="76" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_e_di" bpmnElement="P04_e"><dc:Bounds x="2247.0" y="119.5" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2205.0" y="161.5" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P04_f1_di" bpmnElement="P04_f1"><di:waypoint x="248.0" y="137.5" /><di:waypoint x="296.5" y="137.5" /><di:waypoint x="296.5" y="562.5" /><di:waypoint x="345.0" y="562.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_f2_di" bpmnElement="P04_f2"><di:waypoint x="485.0" y="562.5" /><di:waypoint x="507.5" y="562.5" /><di:waypoint x="507.5" y="292.5" /><di:waypoint x="530.0" y="292.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_f3_di" bpmnElement="P04_f3"><di:waypoint x="670.0" y="292.5" /><di:waypoint x="760.0" y="292.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_f4_di" bpmnElement="P04_f4"><di:waypoint x="810.0" y="292.5" /><di:waypoint x="945.0" y="292.5" /><bpmndi:BPMNLabel><dc:Bounds x="847.5" y="272.5" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_f5_di" bpmnElement="P04_f5"><di:waypoint x="785" y="317.5" /><di:waypoint x="785" y="407.5" /><di:waypoint x="900.0" y="407.5" /><bpmndi:BPMNLabel><dc:Bounds x="791" y="354.5" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_f6_di" bpmnElement="P04_f6"><di:waypoint x="1040.0" y="407.5" /><di:waypoint x="1137.0" y="407.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_f7_di" bpmnElement="P04_f7"><di:waypoint x="970" y="267.5" /><di:waypoint x="970" y="137.5" /><di:waypoint x="1085.0" y="137.5" /><bpmndi:BPMNLabel><dc:Bounds x="976" y="194.5" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_f8_di" bpmnElement="P04_f8"><di:waypoint x="970" y="317.5" /><di:waypoint x="970" y="717.5" /><di:waypoint x="1455.0" y="717.5" /><bpmndi:BPMNLabel><dc:Bounds x="976" y="509.5" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_f9_di" bpmnElement="P04_f9"><di:waypoint x="1225.0" y="137.5" /><di:waypoint x="1270.0" y="137.5" /><di:waypoint x="1270.0" y="292.5" /><di:waypoint x="1315.0" y="292.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_f10_di" bpmnElement="P04_f10"><di:waypoint x="1340" y="317.5" /><di:waypoint x="1340" y="717.5" /><di:waypoint x="1455.0" y="717.5" /><bpmndi:BPMNLabel><dc:Bounds x="1346" y="509.5" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_f11_di" bpmnElement="P04_f11"><di:waypoint x="1340" y="317.5" /><di:waypoint x="1340" y="407.5" /><di:waypoint x="1507.0" y="407.5" /><bpmndi:BPMNLabel><dc:Bounds x="1346" y="354.5" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_f12_di" bpmnElement="P04_f12"><di:waypoint x="1595.0" y="717.5" /><di:waypoint x="1617.5" y="717.5" /><di:waypoint x="1617.5" y="407.5" /><di:waypoint x="1640.0" y="407.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_f13_di" bpmnElement="P04_f13"><di:waypoint x="1780.0" y="407.5" /><di:waypoint x="1802.5" y="407.5" /><di:waypoint x="1802.5" y="562.5" /><di:waypoint x="1825.0" y="562.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_f14_di" bpmnElement="P04_f14"><di:waypoint x="1965.0" y="562.5" /><di:waypoint x="1987.5" y="562.5" /><di:waypoint x="1987.5" y="137.5" /><di:waypoint x="2010.0" y="137.5" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_f15_di" bpmnElement="P04_f15"><di:waypoint x="2150.0" y="137.5" /><di:waypoint x="2247.0" y="137.5" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
